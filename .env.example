# Copiez ce fichier en .env.local puis remplissez les valeurs.
# .env.local est ignoré par Git : n'y mettez jamais de secrets ailleurs.
#
# Valeurs disponibles dans le tableau de bord Supabase :
#   Project Settings > API (ou bouton "Connect" en haut du projet)

# URL du projet, ex. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "publishable" (sb_publishable_...).
# Si votre projet n'affiche que l'ancienne clé "anon", vous pouvez la mettre ici.
# Cette clé est publique (envoyée au navigateur) : la sécurité repose sur les règles RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Uniquement pour le script de démo (npm run seed), en LOCAL ---------------
# Clé SECRÈTE (sb_secret_... ou ancienne clé "service_role") :
#   Project Settings > API Keys > Secret keys
# ⚠️ Elle contourne toutes les règles de sécurité : JAMAIS de préfixe NEXT_PUBLIC_,
# jamais dans le code, jamais dans Git. Sur Vercel seulement si la page /admin
# doit fonctionner en production (variable serveur, sans NEXT_PUBLIC_).
SUPABASE_SECRET_KEY=

# --- Espace administrateur (page /admin), en local ET sur Vercel ---------------
# Adresses e-mail des administrateurs, séparées par des virgules. Sans cette
# variable, personne n'est administrateur et la page /admin reste introuvable.
# La page lit les données avec SUPABASE_SECRET_KEY, côté serveur uniquement :
# pour l'utiliser en production, SUPABASE_SECRET_KEY doit aussi être sur Vercel.
ADMIN_EMAILS=

# Mot de passe commun des comptes de démo créés par npm run seed
# (12 caractères minimum, ne le réutilisez nulle part ailleurs).
DEMO_PASSWORD=
